# PayPal Sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# The app only ever talks to the sandbox environment.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Feedback classification providers (selection is explicit; no automatic fallback).
GEMINI_API_KEY=
# Existing GOOGLE_GENERATIVE_AI_API_KEY is also accepted as a Gemini key alias.
GROQ_API_KEY=
# Selected after the fresh M3 Gemini evaluation and corrected tool smoke.
# The agent and classifier use the same explicit provider/model; no fallback.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# Optional server-only Gemini agent pacing. Unset defaults: 8000 TPM / 5 RPM.
# Set only after verifying the selected key's project quota; positive integers only.
# Supported bounds: TPM <= 250000, RPM <= 15. Groq ignores these settings.
# These change rolling rates, never the 32000-token total run cap.
# GEMINI_AGENT_TPM=100000
# GEMINI_AGENT_RPM=12

# Local: public URL used as the PayPal approval return URL.
# Hosted: required HTTPS origin only (no path or trailing slash), also used for same-origin checks.
APP_URL=http://localhost:3001

# Local: optional SQLite ledger location (defaults to ./data/ledger.sqlite).
# Hosted: required absolute path on durable storage; never use :memory:.
# LEDGER_PATH=./data/ledger.sqlite

# Hosted demo access (server-only). Render enables hosted mode even if HOSTED_DEMO=false.
# For Render set LEDGER_PATH=/var/data/ledger.sqlite on the persistent disk.
# Set APP_URL to the final HTTPS origin without a trailing slash.
# Generate independent random values privately. ADMIN_PASSWORD must be at least
# 32 characters; a generated random password is recommended. HOSTED_SECRET must
# be at least 32 characters. Do not commit actual values or expose them to clients.
# HOSTED_DEMO=true
# ADMIN_PASSWORD=
# HOSTED_SECRET=
