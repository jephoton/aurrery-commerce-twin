# PayPal Sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# The app only ever talks to the sandbox environment.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Feedback classification providers (selection is explicit; no automatic fallback).
GEMINI_API_KEY=
# Existing GOOGLE_GENERATIVE_AI_API_KEY is also accepted as a Gemini key alias.
GROQ_API_KEY=
# Selected after the fresh M3 Gemini evaluation and corrected tool smoke.
# The agent and classifier use the same explicit provider/model; no fallback.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# Optional server-only Gemini agent pacing. Unset defaults: 8000 TPM / 5 RPM.
# Set only after verifying the selected key's project quota; positive integers only.
# Supported bounds: TPM <= 250000, RPM <= 15. Groq ignores these settings.
# These change rolling rates, never the 32000-token total run cap.
# GEMINI_AGENT_TPM=100000
# GEMINI_AGENT_RPM=12

# Local: public URL used as the PayPal approval return URL.
# Hosted: HTTPS origin only (no path or trailing slash), also used for same-origin checks.
# Render may use its trusted RENDER_EXTERNAL_URL when APP_URL is unset; APP_URL wins.
APP_URL=http://localhost:3001

# Local: optional SQLite ledger location (defaults to ./data/ledger.sqlite).
# Explicit non-Render HOSTED_DEMO with SQLite: required absolute durable path.
# Render Free with Turso: leave LEDGER_PATH unset.
# LEDGER_PATH=./data/ledger.sqlite

# Explicit backend selection. Adding Turso credentials alone does not switch
# a local app to a different database.
# LEDGER_BACKEND=sqlite
# Render Free selection after B3's verified import (server-only, private):
# LEDGER_BACKEND=turso
# TURSO_DATABASE_URL=libsql://<database>-<organization>.turso.io
# TURSO_AUTH_TOKEN=<private-auth-token>
# A Turso selection requires both values and no LEDGER_PATH. Never commit them.

# Hosted demo access (server-only). Render enables hosted mode even if HOSTED_DEMO=false.
# Render requires LEDGER_BACKEND=turso, both private Turso values and no LEDGER_PATH.
# B2 sessions and quotas are migrated; B3 signals/cache/import still use raw
# SQLite, so this intermediate checkout must not be deployed as a Turso service.
# Set APP_URL to the final HTTPS origin without a trailing slash, or let Render
# supply RENDER_EXTERNAL_URL until that origin is assigned.
# Generate independent random values privately. ADMIN_PASSWORD must be at least
# 32 characters; a generated random password is recommended. HOSTED_SECRET must
# be at least 32 characters. Do not commit actual values or expose them to clients.
# HOSTED_DEMO=true
# ADMIN_PASSWORD=
# HOSTED_SECRET=
