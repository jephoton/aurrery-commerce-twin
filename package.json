{
  "name": "aurrery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:workers && next dev --port 3001",
    "build": "npm run build:workers && next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "test": "npm run build:workers && vitest run",
    "build:workers": "node scripts/build-workers.mjs",
    "typecheck": "tsc --noEmit",
    "paypal:setup": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/paypal-setup.ts setup",
    "paypal:sync": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/paypal-setup.ts sync",
    "twin:inspect": "tsx scripts/inspect-twin.ts",
    "paypal:check": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/paypal-check.ts",
    "signals:evaluate": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/evaluate-signals.ts",
    "signals:import-cache": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/import-signal-cache.ts",
    "agent:check": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/check-agent.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
